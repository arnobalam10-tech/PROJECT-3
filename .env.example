# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Server-only. NEVER prefix with NEXT_PUBLIC_, never expose to the client, never commit a real
# value. Used only for admin-invite-user actions (Supabase Auth Admin API). Get it from the
# Supabase dashboard: Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend (transactional email for notifications)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=notifications@yourdomain.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
